/*
 * OpenID Connect - Authorization Code Flow WITH Secure Channel
 * EDITED per Fries (2021): full JWT payload + redirect_uri validation
 * ====================================================================
 * This is Model 4 (Secure Channel) + Fries extensions.
 * It combines:
 *   - Secure Channel for token delivery (Model 4 fix)
 *   - Full JWT payload with iss field        (Fries ext 1)
 *   - redirect_uri validation                (Fries ext 2)
 *   - iss binding check in RP               (Fries ext 3)
 *
 * Expected results:
 *   executable          -> verified
 *   token_secrecy       -> VERIFIED  (Secure Channel protects delivery)
 *   rp_auth             -> verified
 *   injective_agreement -> verified
 *   iss_binding         -> verified  (NEW)
 *   redirect_binding    -> verified  (NEW)
 */

theory OIDC_Fries_SecureChannel
begin

builtins: signing, hashing

functions: jwt/2, checkjwt/2
equations: checkjwt(jwt(payload, sk), pk(sk)) = payload

/* ---- SECURE CHANNEL (Tamarin Manual §11) ---- */

rule ChanOut_S:
    [ Out_S($A, $B, x) ]
    --[ ChanOut_S($A, $B, x) ]->
    [ !Sec($A, $B, x) ]

rule ChanIn_S:
    [ !Sec($A, $B, x) ]
    --[ ChanIn_S($A, $B, x) ]->
    [ In_S($A, $B, x) ]

/* ---- SETUP ---- */

rule Setup_IdP:
    [ Fr(~skIdP) ]
    --[ Setup_IdP_Done($IdP) ]->
    [ !IdP_SK($IdP, ~skIdP)
    , !IdP_PK($IdP, pk(~skIdP))
    , Out(pk(~skIdP))
    ]

rule Setup_RP:
    [ Fr(~cid), Fr(~csec) ]
    --[ Setup_RP_Done(~cid) ]->
    [ !RP_Cred(~cid, ~csec, $redirectUri, $IdP)
    , !IdP_KnowsRP($IdP, ~cid, ~csec, $redirectUri)
    , Out(~cid)
    ]

rule Setup_User:
    [ Fr(~uid), Fr(~pw) ]
    --[ Setup_User_Done(~uid) ]->
    [ !IdP_KnowsUser($IdP, ~uid, ~pw) ]

/* ---- PROTOCOL ---- */

rule RP_AuthRequest:
    [ Fr(~state), Fr(~nonce)
    , !RP_Cred(cid, csec, redirectUri, expectedIdP)
    ]
    --[ RP_Start(cid, ~state, ~nonce) ]->
    [ RP_WaitCode(cid, csec, ~state, ~nonce, redirectUri, expectedIdP)
    , Out(<'authreq', cid, ~state, ~nonce, redirectUri>)
    ]

rule IdP_IssueCode:
    [ In(<'authreq', cid, state, nonce, redirectUri_req>)
    , !IdP_KnowsRP($IdP, cid, csec, redirectUri_reg)
    , !IdP_KnowsUser($IdP, uid, pw)
    , Fr(~code)
    ]
    --[ Eq(redirectUri_req, redirectUri_reg)
      , Code_Issued(~code, $IdP, cid, uid, nonce, redirectUri_req)
      ]->
    [ IdP_CodeDB(~code, $IdP, cid, uid, nonce, redirectUri_req)
    , Out(<'code', ~code, state, redirectUri_req>)
    ]

rule RP_TokenRequest:
    [ RP_WaitCode(cid, csec, state, nonce, redirectUri, expectedIdP)
    , In(<'code', code, state, redirectUri>)
    ]
    --[ RP_GotCode(code, cid) ]->
    [ RP_WaitToken(cid, csec, nonce, code, redirectUri, expectedIdP)
    , Out(<'tokenreq', code, cid, csec, redirectUri>)
    ]

/* Token now sent over SECURE CHANNEL + includes iss field */
rule IdP_IssueToken:
    [ In(<'tokenreq', code, cid, csec, redirectUri>)
    , IdP_CodeDB(code, $IdP, cid, uid, nonce, redirectUri)
    , !IdP_KnowsRP($IdP, cid, csec, redirectUri_reg)
    , !IdP_SK($IdP, skIdP)
    ]
    --[ Token_Issued($IdP, uid, cid, nonce)
      , Secret(jwt(<$IdP, uid, cid, nonce>, skIdP))
      ]->
    [ Out_S($IdP, $RP, <'tokenresp', jwt(<$IdP, uid, cid, nonce>, skIdP)>) ]

rule RP_VerifyToken:
    let payload  = checkjwt(tok, pkIdP)
        iss      = fst(payload)
        uid      = fst(snd(payload))
        cid2     = fst(snd(snd(payload)))
        nonce2   = snd(snd(snd(payload)))
    in
    [ RP_WaitToken(cid, csec, nonce, code, redirectUri, expectedIdP)
    , In_S($IdP, $RP, <'tokenresp', tok>)
    , !IdP_PK(expectedIdP, pkIdP)
    ]
    --[ Eq(iss, expectedIdP)
      , Eq(cid2, cid)
      , Eq(nonce2, nonce)
      , RP_Auth(uid, cid, nonce, expectedIdP)
      , Commit(cid, uid, <cid, nonce, expectedIdP>)
      ]->
    [ RP_Session(cid, uid, expectedIdP) ]

/* ---- ADVERSARY ---- */

rule Compromised_RP:
    [ !RP_Cred(cid, csec, redirectUri, expectedIdP) ]
    --[ Compromised(cid) ]->
    [ Out(<cid, csec>) ]

rule Malicious_IdP:
    [ Fr(~skEvil) ]
    --[ Malicious_IdP($EvilIdP) ]->
    [ !EvilIdP_SK($EvilIdP, ~skEvil)
    , Out(pk(~skEvil))
    , Out($EvilIdP)
    ]

rule Malicious_IdP_IssueToken:
    [ !EvilIdP_SK($EvilIdP, skEvil)
    , In(<victimUid, cid, nonce>)
    ]
    --[ Evil_Token($EvilIdP, victimUid, cid, nonce) ]->
    [ Out(jwt(<$EvilIdP, victimUid, cid, nonce>, skEvil)) ]

/* ---- RESTRICTIONS ---- */

restriction Eq:
    "All x y #i. Eq(x,y) @ i ==> x = y"

/* ---- LEMMAS ---- */

lemma executable:
    exists-trace
    "Ex uid cid nonce idp #i. RP_Auth(uid, cid, nonce, idp) @ i"

/* token_secrecy: VERIFIED here (Secure Channel protects delivery) */
lemma token_secrecy:
    "All t #i.
     Secret(t) @ i
     ==> not(Ex #j. K(t) @ j)
       | (Ex cid #k. Compromised(cid) @ k)"

lemma rp_auth:
    "All uid cid nonce idp #i.
     RP_Auth(uid, cid, nonce, idp) @ i
     ==> (Ex code ruri #j.
          Code_Issued(code, idp, cid, uid, nonce, ruri) @ j & j < i)
       | (Ex cid2 #k. Compromised(cid2) @ k)"

lemma injective_agreement:
    "All cid uid data #i #j.
     Commit(cid, uid, data) @ i
     & Commit(cid, uid, data) @ j
     ==> #i = #j"

lemma code_single_use:
    "All code idp cid uid nonce ruri #i #j.
     Code_Issued(code, idp, cid, uid, nonce, ruri) @ i
     & Code_Issued(code, idp, cid, uid, nonce, ruri) @ j
     ==> #i = #j"

lemma iss_binding:
    "All uid cid nonce idp #i.
     RP_Auth(uid, cid, nonce, idp) @ i
     ==> Ex #j.
         Token_Issued(idp, uid, cid, nonce) @ j
         & j < i"

lemma redirect_binding:
    "All code idp cid uid nonce ruri1 ruri2 #i #j.
     Code_Issued(code, idp, cid, uid, nonce, ruri1) @ i
     & Code_Issued(code, idp, cid, uid, nonce, ruri2) @ j
     ==> (#i = #j & ruri1 = ruri2)"

end
